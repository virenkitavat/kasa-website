---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" description="This page doesn’t exist.">
  <PageHero title="This page isn’t here" lede="The link may be old or mistyped. Everything else is where you left it.">
    <div class="btn-row" style="margin-top:2rem">
      <a class="btn btn--primary" href="/">Go to the homepage</a>
      <a class="btn" href="/events">See our events</a>
      <a class="btn" href="/contact">Contact us</a>
    </div>
  </PageHero>
</Base>
