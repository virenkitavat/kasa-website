---
import { hourly, semiPrivate, fullyPrivate, included, extras, formatPrice } from '../data/pricing';
---
<div class="pricing">
  <div>
    <h3>{hourly.title}</h3>
    <p class="muted">{hourly.note}</p>
    <ul class="ladder">
      {hourly.tiers.map((t) => (
        <li>
          <span class="price">{formatPrice(t.price)}</span>
          <span>{t.includes}{t.detail && <small>{t.detail}</small>}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="pricing__side">
    <div class="rate">
      <h3>{semiPrivate.title}</h3>
      <ul>
        <li>
          <span class="price">{formatPrice(semiPrivate.perHour)} <span>an hour</span></span>
          <strong>{semiPrivate.when}.</strong>
          <span class="muted">{semiPrivate.detail}</span>
        </li>
      </ul>
    </div>
    <div class="rate">
      <h3>{fullyPrivate.title}</h3>
      <ul>
        <li>
          <span class="price">{formatPrice(fullyPrivate.perHour)} <span>an hour</span></span>
          <strong>{fullyPrivate.when}.</strong>
          <span class="muted">{fullyPrivate.detail}</span>
        </li>
        {fullyPrivate.flat.map((o) => (
          <li>
            <span class="price">{formatPrice(o.price)} <span>flat rate</span></span>
            <strong>{o.name}</strong>
            <span class="muted">{o.detail}</span>
          </li>
        ))}
      </ul>
    </div>
    <p><span class="vat">All prices include VAT</span></p>
  </div>
</div>
<ul class="included" aria-label="Every booking includes">
  {included.map((i) => <li>{i}</li>)}
</ul>
<div class="notes">
  {extras.map((e) => (
    <div>
      <h3>{e.title}</h3>
      <p>{e.text}</p>
    </div>
  ))}
</div>
